{
  "name": "mfp-flow",
  "version": "0.1.0",
  "description": "Live footprint, volume profile and real aggressor delta for MyFundedPerps markets",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "markets": "tsx scripts/markets.ts",
    "mcp:dev": "tsx src/mcp/server.ts",
    "mcp:build": "esbuild src/mcp/server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-mcp/mfp-flow-mcp.js && chmod +x dist-mcp/mfp-flow-mcp.js",
    "mcp:smoke": "npm run mcp:build && tsx scripts/mcp-smoke.ts"
  },
  "keywords": [],
  "author": "SiS",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "bin": {
    "mfp-flow-mcp": "./dist-mcp/mfp-flow-mcp.js"
  },
  "engines": {
    "node": ">=22"
  }
}
